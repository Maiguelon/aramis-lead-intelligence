      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const expected = [{\"name\":\"event_key\",\"type\":\"string\"},{\"name\":\"state\",\"type\":\"string\"},{\"name\":\"reason\",\"type\":\"string\"},{\"name\":\"contact_id\",\"type\":\"string\"},{\"name\":\"note_id\",\"type\":\"string\"},{\"name\":\"task_id\",\"type\":\"string\"},{\"name\":\"alert_id\",\"type\":\"string\"},{\"name\":\"source_form\",\"type\":\"string\"},{\"name\":\"source_channel\",\"type\":\"string\"},{\"name\":\"fit\",\"type\":\"string\"},{\"name\":\"certainty\",\"type\":\"string\"},{\"name\":\"analysis_mode\",\"type\":\"string\"},{\"name\":\"attempts\",\"type\":\"number\"},{\"name\":\"received_at\",\"type\":\"date\"}];\nconst table = $input.first().json;\nconst actual = table.columns || [];\nconst matches = actual.length === expected.length && expected.every(column => actual.some(item => item.name === column.name && item.type === column.type));\nreturn [{ json: { status: matches ? 'ready' : 'schema_requires_review', tableId: table.id, tableName: table.name, columnsMatched: matches, columnCount: actual.length, executionMode: $mode, crmWritesPerformed: false, emailSent: false } }];"
      }
    }
